// ============================================
// SOCRadar MSSP - Microsoft Sentinel KQL Queries
// ============================================

// -----------------------------------------
// 1. ALARM OVERVIEW
// -----------------------------------------

// Total alarms by severity (last 7 days)
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(7d)
| summarize Count = count() by Severity
| order by Count desc

// Alarms timeline (hourly)
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(24h)
| summarize Count = count() by bin(TimeGenerated, 1h), Severity
| render timechart

// Top 10 alarm types
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(7d)
| summarize Count = count() by AlarmMainType, AlarmSubType
| top 10 by Count
| project AlarmType = strcat(AlarmMainType, " / ", AlarmSubType), Count

// -----------------------------------------
// 2. INCIDENT CORRELATION
// -----------------------------------------

// Match SOCRadar alarms with Microsoft Sentinel incidents
// (incident titles are "[MSSP-<CompanyName>] #<alarm_id> - ...")
let Incidents = SecurityIncident
    | where TimeGenerated > ago(7d)
    | summarize arg_max(TimeGenerated, *) by IncidentNumber
    | where Title startswith "[MSSP-"
    | project IncidentNumber, IncidentStatus = Status, IncidentCreated = CreatedTime,
        AlarmId = extract(@"#(\d+)", 1, Title),
        company_name = extract(@"^\[MSSP-([^\]]+)\]", 1, Title);
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(7d)
| join kind=leftouter Incidents on AlarmId, company_name
| project
    company_name,
    AlarmId,
    AlarmTitle = Title,
    Severity,
    AlarmStatus = Status,
    IncidentStatus,
    IncidentNumber,
    AlarmDate,
    IncidentCreated

// Find alarms without incidents (potential sync issues)
let Incidents = SecurityIncident
    | where TimeGenerated > ago(24h)
    | summarize arg_max(TimeGenerated, *) by IncidentNumber
    | where Title startswith "[MSSP-"
    | project IncidentNumber, IncidentStatus = Status, IncidentCreated = CreatedTime,
        AlarmId = extract(@"#(\d+)", 1, Title),
        company_name = extract(@"^\[MSSP-([^\]]+)\]", 1, Title);
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(24h)
| where Status == "OPEN"
| join kind=leftanti Incidents on AlarmId, company_name
| project TimeGenerated, company_name, AlarmId, Title, Severity

// -----------------------------------------
// 3. AUDIT & OPERATIONS
// -----------------------------------------

// Import operations summary
SOCRadar_MSSP_AuditLog_CL
| where TimeGenerated > ago(24h)
| where EventType in ("AlarmImported", "ImportError", "CompanyImportFailed")
| summarize
    Imported = countif(EventType == "AlarmImported"),
    Failed = countif(EventType in ("ImportError", "CompanyImportFailed"))
    by company_name

// Sync operations summary
SOCRadar_MSSP_AuditLog_CL
| where TimeGenerated > ago(24h)
| where EventType in ("IncidentSynced", "SyncWriteRejected", "CompanySkippedUnmatched")
| summarize
    Synced = countif(EventType == "IncidentSynced"),
    Rejected = countif(EventType == "SyncWriteRejected"),
    SkippedUnmatched = countif(EventType == "CompanySkippedUnmatched")
    by company_name

// Errors in last 24 hours
SOCRadar_MSSP_AuditLog_CL
| where TimeGenerated > ago(24h)
| where EventType in ("ImportError", "CompanyImportFailed", "SyncWriteRejected", "CompanySkippedUnmatched")
| project TimeGenerated, company_name, EventType, AlarmId, Message
| order by TimeGenerated desc

// -----------------------------------------
// 4. LOGIC APP DIAGNOSTICS
// -----------------------------------------

// Failed Logic App runs
AzureDiagnostics
| where ResourceType == "WORKFLOWS"
| where resource_workflowName_s contains "SOCRadar"
| where Status == "Failed"
| project
    TimeGenerated,
    Workflow = resource_workflowName_s,
    Action = action_s,
    Error = error_message_s
| order by TimeGenerated desc

// Logic App run durations
AzureDiagnostics
| where ResourceType == "WORKFLOWS"
| where resource_workflowName_s contains "SOCRadar"
| where Status == "Succeeded"
| summarize
    AvgDuration = avg(duration_s),
    MaxDuration = max(duration_s),
    RunCount = count()
    by resource_workflowName_s

// -----------------------------------------
// 5. SECURITY ANALYSIS
// -----------------------------------------

// High/Critical alarms not yet closed (days counted from import: AlarmDate is a string)
let Incidents = SecurityIncident
    | where TimeGenerated > ago(7d)
    | summarize arg_max(TimeGenerated, *) by IncidentNumber
    | where Title startswith "[MSSP-"
    | project IncidentNumber, IncidentStatus = Status, IncidentCreated = CreatedTime,
        AlarmId = extract(@"#(\d+)", 1, Title),
        company_name = extract(@"^\[MSSP-([^\]]+)\]", 1, Title);
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(7d)
| where Severity in ("HIGH", "CRITICAL")
| join kind=leftouter Incidents on AlarmId, company_name
| where IncidentStatus != "Closed" or isempty(IncidentStatus)
| project
    company_name,
    AlarmId,
    Severity,
    Title,
    AlarmDate,
    DaysOpen = datetime_diff('day', now(), TimeGenerated)
| order by Severity, DaysOpen desc

// Alarm trends by type (week over week)
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(14d)
| summarize
    ThisWeek = countif(TimeGenerated > ago(7d)),
    LastWeek = countif(TimeGenerated between (ago(14d) .. ago(7d)))
    by AlarmMainType
| extend Change = ThisWeek - LastWeek
| order by Change desc

// Mean time to close (incidents)
SecurityIncident
| summarize arg_max(TimeGenerated, *) by IncidentNumber
| where Title startswith "[MSSP-"
| where Status == "Closed"
| extend company_name = extract(@"^\[MSSP-([^\]]+)\]", 1, Title)
| extend MTTC = datetime_diff('hour', ClosedTime, CreatedTime)
| summarize
    AvgHoursToClose = avg(MTTC),
    MedianHoursToClose = percentile(MTTC, 50),
    IncidentCount = count()
    by company_name, Classification

// -----------------------------------------
// 6. WORKBOOK QUERIES
// -----------------------------------------

// Status distribution for pie chart
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(7d)
| summarize Count = count() by Status
| render piechart

// Severity heatmap by day
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(30d)
| extend Day = format_datetime(TimeGenerated, 'yyyy-MM-dd')
| summarize Count = count() by Day, Severity
| render columnchart

// Recent alarms table (for dashboard)
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(24h)
| project
    TimeGenerated,
    AlarmId,
    Severity,
    Type = strcat(AlarmMainType, " / ", AlarmSubType),
    Title,
    Status,
    SOCRadarLink = strcat("https://platform.socradar.com/company/", CompanyId, "/alarm/", AlarmId)
| order by TimeGenerated desc
| take 100

// -----------------------------------------
// 7. ALERT RULES (Scheduled Analytics)
// -----------------------------------------

// Alert: High volume of critical alarms
// Schedule: Every 15 minutes, lookback 15 minutes
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(15m)
| where Severity == "CRITICAL"
| summarize CriticalCount = count()
| where CriticalCount > 5

// Alert: Sync failures detected
// Schedule: Every 1 hour, lookback 1 hour
SOCRadar_MSSP_AuditLog_CL
| where TimeGenerated > ago(1h)
| where EventType in ("ImportError", "CompanyImportFailed", "SyncWriteRejected")
| summarize FailureCount = count()
| where FailureCount > 0

// Alert: No alarms imported (health check)
// Schedule: Every 6 hours, lookback 6 hours
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(6h)
| summarize AlarmCount = count()
| where AlarmCount == 0


// =============================================================
// MSSP-specific queries
// =============================================================

// Company Breakdown - alarm count by company for the last 24 hours
SOCRadar_MSSP_Alarms_CL
| where TimeGenerated > ago(24h)
| summarize AlarmCount = count() by company_name, AlarmMainType
| order by AlarmCount desc

// Per-company audit health - successful runs vs failures last 24h
SOCRadar_MSSP_AuditLog_CL
| where TimeGenerated > ago(24h)
| summarize
    SuccessCount = countif(EventType in ("AlarmImported", "IncidentSynced")),
    ErrorCount = countif(EventType in ("ImportError", "CompanyImportFailed", "SyncWriteRejected"))
    by company_name
| order by ErrorCount desc, company_name asc
